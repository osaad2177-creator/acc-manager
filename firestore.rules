rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request coming from a signed-in Firebase user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: load the caller's profile document from /users/{uid}
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        callerProfile().role == 'manager';
    }

    function isTeamMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        callerProfile().role == 'team_member';
    }

    function isKnownUser() {
      return isManager() || isTeamMember();
    }

    // ── users/{uid} ──────────────────────────────────────────────
    // Every signed-in known user can read profiles (needed to show names
    // like "Noor" / "Hussein" next to activity & history entries, and to
    // populate the Manager's "Assigned To" picker).
    // Only the Manager can create/update user profiles.
    // Nobody can delete a user profile from the client.
    match /users/{uid} {
      allow read: if isKnownUser();
      allow create, update: if isManager();
      allow delete: if false;
    }

    // ── clients/{clientId} ───────────────────────────────────────
    match /clients/{clientId} {

      // Manager can read every client.
      // A team member can ONLY read a client that is assigned to them.
      // Unassigned clients and other team members' clients are never
      // returned to a team member — enforced here, not just hidden in the UI.
      allow read: if isManager()
        || (isTeamMember() && resource.data.assignedTo == request.auth.uid);

      // Create:
      //  - Manager may create a client assigned to anyone (or unassigned).
      //  - A team member may ONLY create a client assigned to themselves —
      //    they cannot hand a brand-new client to someone else.
      //  - Everyone must correctly stamp themselves (not someone else) as
      //    the creator/updater.
      allow create: if
        ( isManager()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid )
        ||
        ( isTeamMember()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid );

      // Update:
      //  - Manager can update ANY client (including reassigning it), but
      //    the original creator stamp can never be altered by anyone.
      //  - A team member can only update a client already assigned to them,
      //    must stamp themselves as updatedBy, and can NEVER change who
      //    created the client, or who it is assigned to.
      allow update: if
        ( isManager()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.createdAt == resource.data.createdAt )
        ||
        ( isTeamMember()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.assignedToName == resource.data.assignedToName );

      // Only the Manager can delete clients.
      allow delete: if isManager();
    }

    // ── activities/{activityId} ──────────────────────────────────
    // Append-only activity log. Each entry is stamped with the assignedTo
    // UID of the client it relates to, so team members only ever see
    // activity tied to their own clients.
    match /activities/{activityId} {
      allow read: if isManager()
        || (isTeamMember() && resource.data.assignedTo == request.auth.uid);

      // Any known user can write an activity entry, but only their own.
      allow create: if isKnownUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}

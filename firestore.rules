rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request coming from a signed-in Firebase user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: load the caller's profile document from /users/{uid}
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        callerProfile().role == 'manager';
    }

    function isTeamMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        callerProfile().role == 'team_member';
    }

    function isKnownUser() {
      return isManager() || isTeamMember();
    }

    // ── users/{uid} ──────────────────────────────────────────────
    // Every signed-in known user can read profiles (needed to show names
    // like "Noor" / "Hussein" next to activity & history entries).
    // Only the Manager can create/update/deactivate user profiles.
    // Nobody can delete a user profile from the client.
    match /users/{uid} {
      allow read: if isKnownUser();
      allow create, update: if isManager();
      allow delete: if false;
    }

    // ── clients/{clientId} ───────────────────────────────────────
    match /clients/{clientId} {
      allow read: if isKnownUser();

      // Any known user can create a client, but only if they correctly
      // stamp themselves (not someone else) as the creator.
      allow create: if isKnownUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      // Any known user can update a client, but:
      //  - they must stamp themselves (not someone else) as updatedBy
      //  - they cannot change who the ORIGINAL creator was
      allow update: if isKnownUser()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt;

      // Only the Manager can delete clients.
      allow delete: if isManager();
    }

    // ── activities/{activityId} ──────────────────────────────────
    // Append-only global activity log.
    match /activities/{activityId} {
      // Only the Manager can view the full activity log.
      allow read: if isManager();

      // Any known user can write an activity entry, but only their own.
      allow create: if isKnownUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
